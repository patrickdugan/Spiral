  have e1 : hitC (2, 2) ::ₘ ({(2, 1), (2, 2), (3, 1), (3, 1)} : Multiset Cat).erase (2, 2) = {(1, 1), (2, 1), (3, 1), (3, 1)} := by decide
  have e2 : missC (2, 2) ::ₘ ({(2, 1), (2, 2), (3, 1), (3, 1)} : Multiset Cat).erase (2, 2) = {(1, 2), (2, 1), (3, 1), (3, 1)} := by decide
  rw [firstPatch, e1, e2, show (2 : ℕ) - 1 = 1 from rfl, v1_1x1_2x1_3x1_3x1] <;> norm_num

theorem v1_2x0_2x1_2x2_3x1 : val 1 {(2, 0), (2, 1), (2, 2), (3, 1)} = (1 : ℚ) := by
  have hmin : ∀ d ∈ ({(2, 0), (2, 1), (2, 2), (3, 1)} : Multiset Cat), 1 ≤ d.2 → finisher (2, 2) ≤ finisher d := by
    intro d hd hd1
    simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hd
    rcases hd with rfl | rfl | rfl | rfl <;> (try norm_num at hd1) <;> (try norm_num)
  rw [val_one_eq _ (by decide) (2, 2) (by decide) (by decide) hmin] <;> norm_num

theorem fp2_2x1_2x2_3x1_3x1__3x1 : firstPatch 2 {(2, 1), (2, 2), (3, 1), (3, 1)} (3, 1) = (8 / 3 : ℚ) := by
  have e1 : hitC (3, 1) ::ₘ ({(2, 1), (2, 2), (3, 1), (3, 1)} : Multiset Cat).erase (3, 1) = {(2, 0), (2, 1), (2, 2), (3, 1)} := by decide
  have e2 : missC (3, 1) ::ₘ ({(2, 1), (2, 2), (3, 1), (3, 1)} : Multiset Cat).erase (3, 1) = {(2, 1), (2, 1), (2, 2), (3, 1)} := by decide
  rw [firstPatch, e1, e2, show (2 : ℕ) - 1 = 1 from rfl, v1_2x0_2x1_2x2_3x1, v2_2x1_2x1_2x2_3x1] <;> norm_num

theorem v2_2x1_2x2_3x1_3x1 : val 2 {(2, 1), (2, 2), (3, 1), (3, 1)} = (2 : ℚ) := by
  apply val_eq_of_cert 1 _ _ (2, 2) (by decide) (by decide) fp2_2x1_2x2_3x1_3x1__2x2
  intro d hd hpos
  simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hd
  rcases hd with rfl | rfl | rfl | rfl
  · rw [fp2_2x1_2x2_3x1_3x1__2x1] <;> norm_num
  · rw [fp2_2x1_2x2_3x1_3x1__2x2] <;> norm_num
  · rw [fp2_2x1_2x2_3x1_3x1__3x1] <;> norm_num
  · rw [fp2_2x1_2x2_3x1_3x1__3x1] <;> norm_num

theorem fp2_2x1_3x1_3x1_3x2__3x2 : firstPatch 2 {(2, 1), (3, 1), (3, 1), (3, 2)} (3, 2) = (8 / 3 : ℚ) := by
  have e1 : hitC (3, 2) ::ₘ ({(2, 1), (3, 1), (3, 1), (3, 2)} : Multiset Cat).erase (3, 2) = {(2, 1), (2, 1), (3, 1), (3, 1)} := by decide
  have e2 : missC (3, 2) ::ₘ ({(2, 1), (3, 1), (3, 1), (3, 2)} : Multiset Cat).erase (3, 2) = {(2, 1), (2, 2), (3, 1), (3, 1)} := by decide
  rw [firstPatch, e1, e2, show (2 : ℕ) - 1 = 1 from rfl, v1_2x1_2x1_3x1_3x1, v2_2x1_2x2_3x1_3x1] <;> norm_num

theorem v2_2x1_3x1_3x1_3x2 : val 2 {(2, 1), (3, 1), (3, 1), (3, 2)} = (8 / 3 : ℚ) := by
  apply val_eq_of_cert 1 _ _ (3, 2) (by decide) (by decide) fp2_2x1_3x1_3x1_3x2__3x2
  intro d hd hpos
  simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hd
  rcases hd with rfl | rfl | rfl | rfl
  · rw [fp2_2x1_3x1_3x1_3x2__2x1] <;> norm_num
  · rw [fp2_2x1_3x1_3x1_3x2__3x1] <;> norm_num
  · rw [fp2_2x1_3x1_3x1_3x2__3x1] <;> norm_num
  · rw [fp2_2x1_3x1_3x1_3x2__3x2] <;> norm_num

theorem fp2_2x1_3x1_3x1_4x2__4x2 : firstPatch 2 {(2, 1), (3, 1), (3, 1), (4, 2)} (4, 2) = (37 / 12 : ℚ) := by
  have e1 : hitC (4, 2) ::ₘ ({(2, 1), (3, 1), (3, 1), (4, 2)} : Multiset Cat).erase (4, 2) = {(2, 1), (3, 1), (3, 1), (3, 1)} := by decide
  have e2 : missC (4, 2) ::ₘ ({(2, 1), (3, 1), (3, 1), (4, 2)} : Multiset Cat).erase (4, 2) = {(2, 1), (3, 1), (3, 1), (3, 2)} := by decide
  rw [firstPatch, e1, e2, show (2 : ℕ) - 1 = 1 from rfl, v1_2x1_3x1_3x1_3x1, v2_2x1_3x1_3x1_3x2] <;> norm_num

theorem v2_2x1_3x1_3x1_4x2 : val 2 {(2, 1), (3, 1), (3, 1), (4, 2)} = (37 / 12 : ℚ) := by
  apply val_eq_of_cert 1 _ _ (4, 2) (by decide) (by decide) fp2_2x1_3x1_3x1_4x2__4x2
  intro d hd hpos
  simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hd
