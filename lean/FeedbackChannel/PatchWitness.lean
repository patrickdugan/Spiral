  · rw [fp2_2x1_3x1_3x1_4x2__3x1] <;> norm_num
  · rw [fp2_2x1_3x1_3x1_4x2__4x2] <;> norm_num

/-! ### The note's witness values -/

/-- **Proposition 7, values as stated (own-count index).** With two hits needed, patching `(2,1)`
first is strictly better than `(4,2)` first in `{(1,1),(2,1),(4,2)}` (`5/2` against `8/3`) and
strictly worse in `{(2,1),(4,2)}` (`19/6` against `37/12`). -/
theorem prop7_note_values :
    firstPatch 2 {(1, 1), (2, 1), (4, 2)} (2, 1) = 5 / 2 ∧
    firstPatch 2 {(1, 1), (2, 1), (4, 2)} (4, 2) = 8 / 3 ∧
    firstPatch 2 {(2, 1), (4, 2)} (2, 1) = 19 / 6 ∧
    firstPatch 2 {(2, 1), (4, 2)} (4, 2) = 37 / 12 :=
  ⟨fp2_1x1_2x1_4x2__2x1, fp2_1x1_2x1_4x2__4x2, fp2_2x1_4x2__2x1, fp2_2x1_4x2__4x2⟩

/-- **A gap in the note's proof of Proposition 7.** In the note's first state the unit category
`(1,1)` is optimal too (`5/2`), and in the second `(4,2)` is optimal. So a rule ranking
`(1,1)` above `(4,2)` above `(2,1)` makes an optimal first patch in *both* of the note's states:
the reversal of `(2,1)` against `(4,2)` alone does not defeat it. -/
theorem prop7_note_pair_insufficient :
    firstPatch 2 {(1, 1), (2, 1), (4, 2)} (1, 1) = val 2 {(1, 1), (2, 1), (4, 2)} ∧
    firstPatch 2 {(2, 1), (4, 2)} (4, 2) = val 2 {(2, 1), (4, 2)} := by
  rw [fp2_1x1_2x1_4x2__1x1, v2_1x1_2x1_4x2, fp2_2x1_4x2__4x2, v2_2x1_4x2]
  exact ⟨rfl, rfl⟩

/-! ### Index rules -/

/-- An index rule with a fixed tie-break ranks categories by a key that depends only on the
category's own counts (for a fixed requirement and fixed global context) and patches the top
category: `c` is the rule's choice in `s` when every other category of `s` has a smaller key. -/
def IsTop {α : Type*} [LinearOrder α] (key : Cat → α) (s : Multiset Cat) (c : Cat) : Prop :=
  c ∈ s ∧ ∀ d ∈ s, d ≠ c → key d < key c

/-- **Proposition 7 (own counts), first-patch form, with a corrected witness pair.** With two hits
needed, `(2,1)` is the *unique* optimal first patch in `{(2,1),(2,1),(4,2)}` (`3` against `37/12`)
and `(4,2)` the unique optimal one in `{(2,1),(4,2)}` (`37/12` against `19/6`). Hence for every
strict ranking `key` of categories by their own counts, the rule's first patch is strictly
suboptimal in one of the two states. -/
theorem prop7_own_counts {α : Type*} [LinearOrder α] (key : Cat → α) (hkey : key (2, 1) ≠ key (4, 2)) :
    (∀ c, IsTop key {(2, 1), (2, 1), (4, 2)} c → val 2 {(2, 1), (2, 1), (4, 2)} < firstPatch 2 {(2, 1), (2, 1), (4, 2)} c) ∨
    (∀ c, IsTop key {(2, 1), (4, 2)} c → val 2 {(2, 1), (4, 2)} < firstPatch 2 {(2, 1), (4, 2)} c) := by
  rcases lt_or_gt_of_ne hkey with h | h
  · left
    rintro c ⟨hc, htop⟩
    simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hc
    rcases hc with rfl | rfl | rfl
    · exact absurd (htop (4, 2) (by decide) (by decide)) (not_lt.2 h.le)
    · exact absurd (htop (4, 2) (by decide) (by decide)) (not_lt.2 h.le)
    · rw [v2_2x1_2x1_4x2, fp2_2x1_2x1_4x2__4x2]; norm_num
  · right
    rintro c ⟨hc, htop⟩
    simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hc
    rcases hc with rfl | rfl
    · rw [v2_2x1_4x2, fp2_2x1_4x2__2x1]; norm_num
    · exact absurd (htop (2, 1) (by decide) (by decide)) (not_lt.2 h.le)

/-- **Proposition 7 (own counts), policy form.** No legal policy that follows a strict own-count
index rule at these two states is optimal: its expected number of patches exceeds the optimum in
one of them. -/
theorem prop7_own_counts_policy {α : Type*} [LinearOrder α] (key : Cat → α)
    (hkey : key (2, 1) ≠ key (4, 2)) (π : Policy) (hπ : Legal π)
    (h1 : IsTop key {(2, 1), (2, 1), (4, 2)} (π 2 {(2, 1), (2, 1), (4, 2)}))
    (h2 : IsTop key {(2, 1), (4, 2)} (π 2 {(2, 1), (4, 2)})) :
    val 2 {(2, 1), (2, 1), (4, 2)} < pval π 2 {(2, 1), (2, 1), (4, 2)} ∨
    val 2 {(2, 1), (4, 2)} < pval π 2 {(2, 1), (4, 2)} := by
  rcases prop7_own_counts key hkey with h | h
  · left
    exact (h _ h1).trans_le ((val_le_pval π hπ _ 2 _ rfl (by decide)).2 (by norm_num) (by decide))
  · right
    exact (h _ h2).trans_le ((val_le_pval π hπ _ 2 _ rfl (by decide)).2 (by norm_num) (by decide))

/-- The richer contexts (total items, total failures, number of categories) cannot separate these
two states: they agree on all three. -/
theorem prop7_context_pair :
    items {(2, 1), (2, 1), (4, 1), (4, 2)} = items {(2, 1), (3, 1), (3, 1), (4, 2)} ∧
    fails {(2, 1), (2, 1), (4, 1), (4, 2)} = fails {(2, 1), (3, 1), (3, 1), (4, 2)} ∧
    Multiset.card ({(2, 1), (2, 1), (4, 1), (4, 2)} : Multiset Cat) =
      Multiset.card ({(2, 1), (3, 1), (3, 1), (4, 2)} : Multiset Cat) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **Proposition 7 (with totals and category count), corrected witness pair.** With two hits
needed, 12 items, 5 failures and 4 categories, `(2,1)` is the unique optimal first patch in
`{(2,1),(2,1),(4,1),(4,2)}` (`3`; `(4,1)` gives `29/8`, `(4,2)` gives `37/12`) and `(4,2)` the
unique optimal one in `{(2,1),(3,1),(3,1),(4,2)}` (`37/12`; `(2,1)` gives `19/6`, `(3,1)` gives
`7/2`). So every strict index rule that sees the own counts, the requirement, the totals and the
category count makes a strictly suboptimal first patch in one of them. -/
theorem prop7_with_context {α : Type*} [LinearOrder α] (key : Cat → α) (hkey : key (2, 1) ≠ key (4, 2)) :
    (∀ c, IsTop key {(2, 1), (2, 1), (4, 1), (4, 2)} c →
      val 2 {(2, 1), (2, 1), (4, 1), (4, 2)} < firstPatch 2 {(2, 1), (2, 1), (4, 1), (4, 2)} c) ∨
    (∀ c, IsTop key {(2, 1), (3, 1), (3, 1), (4, 2)} c →
      val 2 {(2, 1), (3, 1), (3, 1), (4, 2)} < firstPatch 2 {(2, 1), (3, 1), (3, 1), (4, 2)} c) := by
  rcases lt_or_gt_of_ne hkey with h | h
  · left
    rintro c ⟨hc, htop⟩
    simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hc
    rcases hc with rfl | rfl | rfl | rfl
    · exact absurd (htop (4, 2) (by decide) (by decide)) (not_lt.2 h.le)
    · exact absurd (htop (4, 2) (by decide) (by decide)) (not_lt.2 h.le)
    · rw [v2_2x1_2x1_4x1_4x2, fp2_2x1_2x1_4x1_4x2__4x1]; norm_num
    · rw [v2_2x1_2x1_4x1_4x2, fp2_2x1_2x1_4x1_4x2__4x2]; norm_num
  · right
    rintro c ⟨hc, htop⟩
    simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hc
    rcases hc with rfl | rfl | rfl | rfl
    · rw [v2_2x1_3x1_3x1_4x2, fp2_2x1_3x1_3x1_4x2__2x1]; norm_num
    · rw [v2_2x1_3x1_3x1_4x2, fp2_2x1_3x1_3x1_4x2__3x1]; norm_num
    · rw [v2_2x1_3x1_3x1_4x2, fp2_2x1_3x1_3x1_4x2__3x1]; norm_num
    · exact absurd (htop (2, 1) (by decide) (by decide)) (not_lt.2 h.le)

/-- **Proposition 8 (witness).** In `{(2,1),(5,2)}` with two hits needed, the rates are `1/2` and
`2/5`, yet patching `(5,2)` first needs `69/20` patches and `(2,1)` first `7/2`; `69/20` is the
optimum. -/
theorem prop8_witness :
    rate (5, 2) < rate (2, 1) ∧
    firstPatch 2 {(2, 1), (5, 2)} (5, 2) = 69 / 20 ∧
    firstPatch 2 {(2, 1), (5, 2)} (2, 1) = 7 / 2 ∧
    val 2 {(2, 1), (5, 2)} = 69 / 20 :=
  ⟨by norm_num, fp2_2x1_5x2__5x2, fp2_2x1_5x2__2x1, v2_2x1_5x2⟩


/-- **Greedy is not optimal** (the note's witness). In `{(2,1),(4,2)}` with two hits needed the
rates tie at `1/2` and greedy (ties to the smaller category) patches `(2,1)` first; every legal
policy that does so costs at least `19/6`, strictly more than the optimum `37/12`. -/
theorem greedy_not_optimal (π : Policy) (hπ : Legal π) (h : π 2 {(2, 1), (4, 2)} = (2, 1)) :
    rate (2, 1) = rate (4, 2) ∧ val 2 {(2, 1), (4, 2)} = 37 / 12 ∧
      (19 / 6 : ℚ) ≤ pval π 2 {(2, 1), (4, 2)} ∧ val 2 {(2, 1), (4, 2)} < pval π 2 {(2, 1), (4, 2)} := by
  have hfp := (val_le_pval π hπ _ 2 ({(2, 1), (4, 2)} : Multiset Cat) rfl (by decide)).2
    (by norm_num) (by decide)
  rw [h, fp2_2x1_4x2__2x1] at hfp
  refine ⟨by norm_num, v2_2x1_4x2, hfp, ?_⟩
  rw [v2_2x1_4x2]
  linarith

end FeedbackChannel.PatchWitness
