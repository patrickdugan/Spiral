import FeedbackChannel.PatchDP

/-!
# Proposition 7 (no index rule is optimal): exact witness values

Source: `paper/evaluation_feedback_lattice.md` (version 0.6), §3, Propositions 7 and 8; Python
`first_patch_values`, `index_rule_fixture`, `preference_reversals`.

Every value below is computed from the definition of the dynamic programme in
`FeedbackChannel.PatchDP` (`val`, `firstPatch`): the `v2_…`/`fp2_…` lemmas evaluate the Bellman
recursion bottom-up on every state the witnesses reach (`val_eq_of_cert`), and the one-hit leaves
use Theorem 10 (`val_one_eq`). Multiset identities are checked by `decide` and rational arithmetic
by `norm_num`; nothing is evaluated by compiled code. The lemma section was generated by a script from the
exact Python programme and is checked here in full.

Lemma names: `v2_2x1_4x2` is `val 2 {(2, 1), (4, 2)}`; `fp2_2x1_4x2__2x1` is
`firstPatch 2 {(2, 1), (4, 2)} (2, 1)`.
-/

namespace FeedbackChannel.PatchWitness

open FeedbackChannel.PatchDP

theorem v1_0x0_2x1_4x2 : val 1 {(0, 0), (2, 1), (4, 2)} = (3 / 2 : ℚ) := by
  have hmin : ∀ d ∈ ({(0, 0), (2, 1), (4, 2)} : Multiset Cat), 1 ≤ d.2 → finisher (2, 1) ≤ finisher d := by
    intro d hd hd1
    simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hd
    rcases hd with rfl | rfl | rfl <;> (try norm_num at hd1) <;> (try norm_num)
  rw [val_one_eq _ (by decide) (2, 1) (by decide) (by decide) hmin] <;> norm_num

theorem fp2_1x1_2x1_4x2__1x1 : firstPatch 2 {(1, 1), (2, 1), (4, 2)} (1, 1) = (5 / 2 : ℚ) := by
