diff --git a/crates/stwo/src/prover/vcs_lifted/disk.rs b/crates/stwo/src/prover/vcs_lifted/disk.rs
new file mode 100644
index 0000000..28c8b4c
--- /dev/null
+++ b/crates/stwo/src/prover/vcs_lifted/disk.rs
@@ -0,0 +1,158 @@
+use std::fs::{remove_file, File, OpenOptions};
+use std::io::{self, ErrorKind, Write};
+use std::os::unix::fs::{FileExt, OpenOptionsExt};
+use std::path::Path;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+#[cfg(feature = "parallel")]
+use rayon::prelude::*;
+
+use super::ops::{DiskHashCodec, MerkleOpsLifted};
+use crate::core::fields::m31::BaseField;
+use crate::core::vcs::hash::Hash;
+use crate::core::vcs_lifted::merkle_hasher::MerkleHasherLifted;
+use crate::prover::backend::{Col, Column};
+
+const HASH_BYTES: usize = 32;
+const NODES_PER_BATCH: usize = 8 * 1024;
+const SYNC_INTERVAL_BYTES: usize = 64 * 1024 * 1024;
+
+#[derive(Debug)]
+pub(super) struct DiskMerkleLayers<T: Hash> {
+    file: File,
+    offsets: Vec<u64>,
+    decode: fn([u8; HASH_BYTES]) -> T,
+}
+
+impl<T: Hash> DiskMerkleLayers<T> {
+    pub(super) fn commit<B, H>(
+        directory: &Path,
+        columns: &[&Col<B, BaseField>],
+        log_size: u32,
+        (encode, decode): DiskHashCodec<T>,
+    ) -> io::Result<Self>
+    where
+        B: MerkleOpsLifted<H>,
+        H: MerkleHasherLifted<Hash = T>,
+    {
+        assert!(!columns.is_empty());
+        assert!(columns
+            .iter()
+            .all(|col| col.len().is_power_of_two() && col.len() > 1));
+        let leaves = 1_usize
+            .checked_shl(log_size)
+            .and_then(|n| n.checked_mul(HASH_BYTES * 2).map(|_| n))
+            .ok_or_else(|| io::Error::new(ErrorKind::InvalidInput, "Merkle tree too large"))?;
+        let shifts: Vec<_> = columns
+            .iter()
+            .map(|col| {
+                log_size
+                    .checked_sub(col.len().ilog2())
+                    .expect("column exceeds lifting size")
+            })
+            .collect();
+        let mut file = open_anonymous_file(directory)?;
+        let mut encoded = vec![0; HASH_BYTES * NODES_PER_BATCH];
+        let mut children = vec![0; HASH_BYTES * 2 * NODES_PER_BATCH];
+        let mut dirty_bytes = 0;
+
+        for first in (0..leaves).step_by(NODES_PER_BATCH) {
+            let count = (leaves - first).min(NODES_PER_BATCH);
+            let bytes = &mut encoded[..count * HASH_BYTES];
+            #[cfg(feature = "parallel")]
+            let records = bytes.par_chunks_exact_mut(HASH_BYTES);
+            #[cfg(not(feature = "parallel"))]
+            let records = bytes.chunks_exact_mut(HASH_BYTES);
+            records.enumerate().for_each(|(relative, record)| {
+                let index = first + relative;
+                let mut hasher = H::default();
+                for (col, shift) in columns.iter().zip(&shifts) {
+                    // This is the stock mixed-height leaf projection. Lifting keeps the
+                    // parity of the leaf and replicates adjacent pairs in bit-reversed order.
+                    let source = (index >> (*shift + 1) << 1) + (index & 1);
+                    hasher.update_leaf(&[<B as MerkleOpsLifted<H>>::disk_leaf_value(col, source)]);
+                }
+                record.copy_from_slice(&encode(hasher.finalize()));
+            });
+            append(&mut file, bytes, &mut dirty_bytes)?;
+        }
+
+        let mut offsets = vec![0];
+        let mut end = (leaves * HASH_BYTES) as u64;
+        for height in (0..log_size).rev() {
+            let child_offset = *offsets.last().unwrap();
+            offsets.push(end);
+            let width = 1_usize << height;
+            for first in (0..width).step_by(NODES_PER_BATCH) {
+                let count = (width - first).min(NODES_PER_BATCH);
+                let inputs = &mut children[..count * HASH_BYTES * 2];
+                file.read_exact_at(inputs, child_offset + (first * HASH_BYTES * 2) as u64)?;
+                let bytes = &mut encoded[..count * HASH_BYTES];
+                for (record, pair) in bytes
+                    .chunks_exact_mut(HASH_BYTES)
+                    .zip(inputs.chunks_exact(HASH_BYTES * 2))
+                {
+                    let left = decode(pair[..HASH_BYTES].try_into().unwrap());
+                    let right = decode(pair[HASH_BYTES..].try_into().unwrap());
+                    record.copy_from_slice(&encode(H::hash_children((left, right))));
+                }
+                append(&mut file, bytes, &mut dirty_bytes)?;
+            }
+            end += (width * HASH_BYTES) as u64;
+        }
+        file.sync_data()?;
+        offsets.reverse();
+        Ok(Self {
+            file,
+            offsets,
+            decode,
+        })
+    }
+
+    pub(super) fn log_size(&self) -> u32 {
+        (self.offsets.len() - 1) as u32
+    }
+
+    pub(super) fn hash_at(&self, height: usize, index: usize) -> io::Result<T> {
+        assert!(height < self.offsets.len() && index < 1_usize << height);
+        let mut bytes = [0; HASH_BYTES];
+        self.file.read_exact_at(
+            &mut bytes,
+            self.offsets[height] + (index * HASH_BYTES) as u64,
+        )?;
+        Ok((self.decode)(bytes))
+    }
+}
+
+fn open_anonymous_file(directory: &Path) -> io::Result<File> {
+    static NEXT_FILE: AtomicU64 = AtomicU64::new(0);
+    loop {
+        let id = NEXT_FILE.fetch_add(1, Ordering::Relaxed);
+        let path = directory.join(format!(".stwo-merkle-{}-{id}.tmp", std::process::id()));
+        match OpenOptions::new()
+            .create_new(true)
+            .read(true)
+            .write(true)
+            .mode(0o600)
+            .open(&path)
+        {
+            Ok(file) => {
+                // Unix keeps the data available to this descriptor until it closes.
+                remove_file(&path)?;
+                return Ok(file);
+            }
+            Err(error) if error.kind() == ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+    }
+}
+
+fn append(file: &mut File, bytes: &[u8], dirty_bytes: &mut usize) -> io::Result<()> {
+    file.write_all(bytes)?;
+    *dirty_bytes += bytes.len();
+    if *dirty_bytes >= SYNC_INTERVAL_BYTES {
+        file.sync_data()?;
+        *dirty_bytes = 0;
+    }
+    Ok(())
+}
