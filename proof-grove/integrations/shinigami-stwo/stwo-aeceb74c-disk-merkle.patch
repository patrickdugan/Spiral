+        for _ in 0..log_size {
+            layers.push(
+                <SimdBackend as MerkleOpsLifted<Blake2sMerkleHasher>>::build_next_layer(
+                    layers.last().unwrap(),
+                ),
+            );
+        }
+        layers.reverse();
+        let memory = Tree::in_memory(layers);
+        let mut raw_leaf = Blake2sHasher::default();
+        for _ in &sorted {
+            raw_leaf.update(&P.to_le_bytes());
+        }
+        assert_eq!(memory.hash_at(log_size as usize, 0), raw_leaf.finalize());
+        assert_eq!(disk.log_size(), memory.log_size());
+        assert_eq!(disk.root(), memory.root());
+        for (height, layer) in memory.layers.iter().enumerate() {
+            for (index, digest) in layer.iter().enumerate() {
+                assert_eq!(disk.hash_at(height, index), *digest);
+            }
+        }
+
+        let limit = 1 << log_size;
+        let positions: Vec<_> = [0, 1, 9, 8191, 8192]
+            .into_iter()
+            .filter(|&index| index < limit - 1)
+            .chain([limit - 1])
+            .collect();
+        let (disk_values, disk_opening) = disk.decommit(&positions, input.clone());
+        let (memory_values, memory_opening) = memory.decommit(&positions, input);
+        assert_eq!(disk_values[0][0], BaseField::zero());
+        assert_eq!(disk_values, memory_values);
+        assert_eq!(
+            disk_opening.decommitment.hash_witness,
+            memory_opening.decommitment.hash_witness
+        );
+        assert_eq!(
+            disk_opening.aux.all_node_values,
+            memory_opening.aux.all_node_values
+        );
+    }
 }
